# GitHub Copilot API (used for Vision + text analysis)
# Get from: https://github.com/settings/tokens — classic PAT, no special scopes needed
GITHUB_TOKEN=your_github_token_here

# Optional: override the AI API endpoint
# Default (works with PATs): https://models.inference.ai.azure.com
# Alternative (needs OAuth token via 'gh auth token'): https://api.githubcopilot.com
# COPILOT_API_URL=https://models.inference.ai.azure.com

# Optional: override the model (default: openai/gpt-4o)
# COPILOT_MODEL=openai/gpt-4o-mini

# Microsoft Graph auth for SharePoint/Stream download
# ── Option 1 (easiest): Just run 'az login' in your terminal. No config needed.
#
# ── Option 2 (no admin required): Set only AZURE_TENANT_ID.
#    On first use you'll be prompted to sign in via browser (device code flow).
#    Uses Microsoft's own Azure CLI app ID — no app registration needed.
# AZURE_TENANT_ID=your_tenant_id_here
#
# ── Option 3 (admin required): Set both for a custom app registration.
# AZURE_TENANT_ID=your_tenant_id_here
# AZURE_CLIENT_ID=your_app_client_id_here

# Optional: path to browser cookies.txt for yt-dlp download fallback
# Export from browser using 'Get cookies.txt LOCALLY' extension (navigate to SharePoint first)
# COOKIES_FILE=C:\path\to\cookies.txt
