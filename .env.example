# GitHub Copilot API (used for Vision + text analysis)
# Get from: https://github.com/settings/tokens — needs copilot scope
GITHUB_TOKEN=your_github_token_here

# Microsoft Graph (for SharePoint/Stream download)
# Register an app at https://portal.azure.com → App registrations
# Required API permissions: Files.Read.All, Sites.Read.All, User.Read
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_ID=your_app_client_id_here
